#!/usr/bin/env bash
set -euo pipefail

root="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
if [[ "${1:-}" == bluetooth ]]; then
    shift
    exec "$root/scripts/bluetooth.sh" "$@"
fi
binary="$root/bin/soundshare"
if [[ ! -x "$binary" ]]; then
    binary="$root/pc/target/release/soundshare"
fi

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
    if [[ -x "$binary" ]]; then
        exec "$binary" "$@"
    fi
    cat <<'EOF'
Uso: ./soundshare [pc2phone|phone2pc] [-s SERIAL] [-o SALIDA]
Prepara la PC en la primera ejecución, instala la APK requerida si está disponible
y abre la app al conectar el teléfono. Activá y autorizá la depuración USB.
Instalación manual: ./soundshare install [ruta.apk]
Bluetooth Móvil → PC: ./soundshare bluetooth [status|list|connect MAC|disconnect MAC]
Para desactivar la instalación automática: SOUNDSHARE_NO_AUTO_INSTALL=1 ./soundshare
Para preparar la PC por separado: ./scripts/setup.sh
EOF
    exit 0
fi

# La primera ejecución desde el código prepara y compila solamente la PC.
if [[ ! -x "$binary" ]]; then
    "$root/scripts/setup.sh"
fi

# Un paquete ya compilado solo necesita las dependencias de ejecución.
adb_ready=false
if [[ -n "${ADB:-}" && -x "$ADB" ]] || command -v adb >/dev/null 2>&1; then
    adb_ready=true
else
    for sdk in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" "$HOME/Android/Sdk"; do
        if [[ -n "$sdk" && -x "$sdk/platform-tools/adb" ]]; then
            adb_ready=true
            break
        fi
    done
fi
if ! $adb_ready || ldd "$binary" 2>&1 | grep -q 'not found'; then
    "$root/scripts/setup.sh"
fi

exec "$binary" "$@"
